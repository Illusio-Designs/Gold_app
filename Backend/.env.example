# ------------------------------------------------------------------
# Amrut Backend — sample environment file
# Copy to `.env` and fill in real values.  Never commit the real .env.
# ------------------------------------------------------------------

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=amrut_jewels

# --- Auth ---
# REQUIRED. The server refuses to start without it. Use a long random string.
JWT_SECRET=change_me_to_a_long_random_secret

# --- URLs ---
# Public base URL of the API (used to build absolute image/file URLs)
PRODUCTION_URL=https://api.your-domain.com
# Optional explicit base URL override (falls back to request host if unset)
BASE_URL=

# --- LAN / dev networking (optional) ---
# Set USE_LAN=true (or LAN_MODE=true) to build URLs against your LAN IP in dev
USE_LAN=false
LAN_MODE=false

# --- Cloudinary (image storage; optional — falls back to local /uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Firebase Cloud Messaging (push notifications) ---
# Credentials are loaded from a service-account JSON file placed in Backend/,
# referenced by firebaseNotificationService.js. Provision it via your secret
# store (do NOT commit it). No Firebase env vars are required here.

# NOTE: OCR and AI/background-removal have been removed — no GOOGLE_AI_API_KEY,
# GEMINI_*, ENABLE_BG_REMOVAL, or Tesseract config is needed anymore.

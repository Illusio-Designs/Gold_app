# Amrut B2B — iOS release automation.
#
# `beta` builds a signed App Store archive and uploads it to TestFlight.
#
# Signing uses fastlane MATCH: it creates (once) a real App Store distribution
# certificate + provisioning profile for com.Amrutt via the App Store Connect
# API key, and stores them AES-encrypted in the `fastlane-certs` branch of this
# repo. Every run then just fetches + installs them. This replaces Xcode "cloud
# signing", which this account can't use headlessly ("Cloud signing permission
# error" at export).
#
# Required env (GitHub secrets → passed by the workflow):
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT  — App Store Connect API key
#   MATCH_PASSWORD   — passphrase that encrypts the stored certs (any value)
#   MATCH_GIT_URL    — git URL (with token) of the cert storage repo/branch
#
# The signing team (8LARDGKQSN) is already set in the Xcode project.

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # Bump the build number above the latest TestFlight build so every upload
    # is unique.
    increment_build_number(
      xcodeproj: "Amrut.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 5).to_i + 1
    )

    # A dedicated CI keychain with a KNOWN password. Without this, match imports
    # the cert into the runner's login.keychain and can't set the key partition
    # list, so codesign hangs forever on a keychain UI-permission popup on the
    # headless runner (the build timed out at "Signing Amrut.app").
    keychain_name = "ci.keychain"
    keychain_password = "ci-keychain-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Fetch the distribution cert + App Store profile (already created & stored
    # in the fastlane-certs branch on the first run) into the CI keychain.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "com.Amrutt",
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "fastlane-certs",
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      readonly: true
    )

    # Point the Xcode project at the match profile with manual signing, for both
    # the archive and the export.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Amrut.xcodeproj",
      team_id: "8LARDGKQSN",
      bundle_identifier: "com.Amrutt",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.Amrutt"
    )

    build_app(
      workspace: "Amrut.xcworkspace",
      scheme: "Amrut",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.Amrutt" => "match AppStore com.Amrutt"
        }
      },
      output_directory: "build",
      output_name: "Amrut.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

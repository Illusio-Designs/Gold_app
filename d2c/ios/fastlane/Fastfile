# Amrut D2C — iOS release automation.
#
# `beta` builds a signed App Store archive and uploads it to TestFlight.
#
# Signing uses fastlane MATCH: it creates (once) a real App Store distribution
# certificate + provisioning profile for com.Amrutt.d2c via the App Store
# Connect API key, and stores them AES-encrypted in the `fastlane-certs` branch
# of this repo (shared with b2b — a new profile is added for the d2c bundle id).
#
# Required env (GitHub secrets → passed by the workflow):
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT  — App Store Connect API key
#   MATCH_PASSWORD   — passphrase that encrypts the stored certs (SAME value as b2b)
#   MATCH_GIT_URL    — git URL (with token) of the cert storage repo/branch
#
# FIRST-TIME PREREQUISITES (do once on Apple's side):
#   • App Store Connect → My Apps → + → create the app for bundle id
#     `com.Amrutt.d2c` (otherwise latest_testflight_build_number / upload fail).
#   • Accept any pending agreement in App Store Connect (Business / Agreements).
#   • The ASC API key must have "App Manager" access (same key as b2b works).
#
# The signing team (8LARDGKQSN) is already set in the Xcode project.

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # Bump the build number above the latest TestFlight build so every upload is
    # unique. First-ever build: initial_build_number 0 → this run becomes 1.
    increment_build_number(
      xcodeproj: "Amrut.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0).to_i + 1
    )

    # A dedicated CI keychain with a KNOWN password, so codesign never hangs on a
    # keychain UI-permission popup on the headless runner.
    keychain_name = "ci.keychain"
    keychain_password = "ci-keychain-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Fetch/create the distribution cert + App Store profile for com.Amrutt.d2c.
    # readonly:false so the FIRST run can create the d2c profile (the dist cert is
    # reused from the shared store); safe to leave on — it's a no-op once created.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "com.Amrutt.d2c",
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "fastlane-certs",
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      readonly: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Amrut.xcodeproj",
      team_id: "8LARDGKQSN",
      bundle_identifier: "com.Amrutt.d2c",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.Amrutt.d2c"
    )

    build_app(
      workspace: "Amrut.xcworkspace",
      scheme: "Amrut",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.Amrutt.d2c" => "match AppStore com.Amrutt.d2c"
        }
      },
      output_directory: "build",
      output_name: "Amrut.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
